<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SharpCogsInc.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SharpCogsInc.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" ColumnDefinitions="Auto,Auto,Auto" Margin="10" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
    <ComboBox SelectedItem="{Binding SelectedClashAccount, Mode=OneWayToSource}" VerticalAlignment="Center" HorizontalAlignment="Center" SelectedIndex="0" ItemsSource="{Binding ClashAccounts}"></ComboBox>
        <Button Grid.Row="0" Grid.Column="1" Content="Add Account" Command="{Binding GoToRegisterCommand}"></Button>
        <Button Grid.Row="0" Grid.Column="2" Command="{Binding GetMetaDataCommand }">get metadata</Button>
    </Grid> 
</UserControl>
